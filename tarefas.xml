<tab title="Treinos e Tarefas" width="220">
    <layout height="120" align="top" margins="{left=5, top=5}">
        <label align="top" height="25" text="Penalidades de treino e estudo" />
        <layout align="top" height="65">
            <layout align="left" width="120" margins="{left=10}">
                <rectangle align="top" height="25" color="#6B8E23">
                    <label align="client" text="Físico" horzTextAlign="center" />
                </rectangle>
                <edit align="top" height="30" field="fisico" type="float" min="0"
                    horzTextAlign="center" hint="Penalidade exclusiva de treinos e práticas físicas. Não altera as outras rolagens da ficha." />
                <dataLink field="fisico">
                    <event name="onChange">
                        require("tarefas_script.lua").trainingModifierChanged(sheet, "fisico", oldValue, newValue)
                    </event>
                </dataLink>
            </layout>
            <layout align="left" width="120" margins="{left=10}">
                <rectangle align="top" height="25" color="#6B8E23">
                    <label align="client" text="Mental" horzTextAlign="center" />
                </rectangle>
                <edit align="top" height="30" field="mental" type="float" min="0"
                    horzTextAlign="center" hint="Penalidade exclusiva de estudos e treinos mentais. Não altera as outras rolagens da ficha." />
                <dataLink field="mental">
                    <event name="onChange">
                        require("tarefas_script.lua").trainingModifierChanged(sheet, "mental", oldValue, newValue)
                    </event>
                </dataLink>
            </layout>
        </layout>
        <label align="top" height="25" text="Só para treinos e estudos." />
    </layout>
    <layout height="50"
        align="top">

        <button text="Treinar" align="top"
            height="30"
            margins="{left = 5, top = 15, right = 5}"
            horzTextAlign="center">
            <event name="onClick">
                require("tarefas_script.lua").treinar(sheet)
            </event>
        </button>
    </layout>
    <scrollBox align="client">


        <button left="20" top="20" height="25" text="Nova Tarefa" width="80"
            onClick="self.kekzin:append();" />

        <recordList name="kekzin" field="tarefasRecordList" templateForm="frmItemDeMagia"
            left="0" top="60" width="300" autoHeight="true" />
    </scrollBox >
</tab>
