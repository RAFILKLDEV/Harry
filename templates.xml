<form>
    <template name="label3">
        <layout align="left" margins="{left=10}" width="80">
            <rectangle top="7" left="7" color="DarkSlateBlue" width="65" height="20">
                <label align="client" text="$(text)" horzTextAlign="center" />
            </rectangle>
            <edit top="27" width="80" height="25" field="$(field)" horzTextAlign="center" />
        </layout>
    </template>

    <template name="levelLabel">
        <layout align="left" margins="{left=10}" width="160">
            <rectangle top="7" left="27" color="DarkSlateBlue" width="80"
                height="20">
                <label align="left" width="50" margins="{left=4}" text="$(text)"
                    horzTextAlign="center" fontColor="white" />
                <edit name="$(field)GradBadge" align="right" width="25"
                    margins="{right=4,top=1,bottom=1}" text="0"
                    horzTextAlign="center" transparent="true" fontSize="13"
                    fontColor="green" fontStyle="bold" readOnly="true" />
            </rectangle>
            <layout top="27" width="160" height="25">
                <edit top="0" width="160" height="25" field="$(field)_name"
                    horzTextAlign="center" />
                <edit top="0" width="160" height="25" field="$(field)_array"
                    horzTextAlign="center" />
                <edit top="0" width="160" height="25" field="$(field)_grad"
                    horzTextAlign="center">
                    <event name="onChange">
                        require("templates_script.lua").updateGradBadge(self, sheet, "$(field)", newValue)
                    </event>
                </edit>
                <dataLink field="$(field)_grad">
                    <event name="onChange">
                        require("templates_script.lua").updateGradBadge(self, sheet, "$(field)", newValue)
                    </event>
                </dataLink>
                <edit name="$(field)" top="0" width="160" height="25" field="$(field)" horzTextAlign="center" hitTest="true" hint="">
                    <event name="onMouseEnter">
                        require("templates_script.lua").updateFieldHint(self, sheet, "$(field)")
                    </event>
                </edit>
                <button text="-" align="left" width="20">
                    <event name="onClick">
                        require("templates_script.lua").changeSpellLevel(self, sheet, "$(field)", -1)
                    </event>
                </button>
                <button text="+" align="right" width="20">
                    <event name="onClick">
                        require("templates_script.lua").changeSpellLevel(self, sheet, "$(field)", 1)
                    </event>
                </button>
            </layout>
        </layout>
    </template>


    <template name="labelFeitico">
        <layout align="left" margins="{left=10}" width="160">
            <rectangle top="7" left="27" color="DarkSlateBlue" width="80" height="20">
                <label align="client" text="$(text)" horzTextAlign="center" fontColor="white" />
            </rectangle>
            <edit top="27" width="160" height="25" field="$(field)" horzTextAlign="center" />
        </layout>
    </template>

    <template name="CheckCondition">
        <rectangle height="35" align="top" margins="{top=3}" color="$(cor)">
            <checkBox align="left" width="20" text="Caixa de marcacao" field="$(name)">
                <event name="onChange">
                    require("templates_script.lua").checkConditionChanged(self, sheet, "$(name)")
                </event>
            </checkBox>
            <label name="$(name)" align="left" width="80" text="$(texto)" />
        </rectangle>
    </template>

    <template name="LabelComEdit">
        <layout height="30" align="top" margins="{top=3}">
            <rectangle color="black" align="left" width="$(wid)">
                <label name="$(name)" text="$(nome)" top="5"
                    horzTextAlign="center">
                </label>
                <event name="onClick">
                    require("templates_script.lua").rollLabelComEdit(self, sheet, "$(name)", "$(total)")
                </event>
            </rectangle>

            <edit field="$(atr)" align="left"
                margins="{left = 5}" width="30"
                horzTextAlign="center" readOnly="true" />
            <edit field="$(grad)" align="left"
                margins="{left = 5}" width="30"
                horzTextAlign="center" />
            <edit field="$(out)" align="left"
                margins="{left = 5}" width="30"
                horzTextAlign="center" />
            <label field="$(total)" align="left"
                margins="{left = 5}" width="30"
                horzTextAlign="center" />
        </layout>
    </template>

    <template name="Quadribol">
        <layout height="30" align="top" margins="{top=3}">
            <rectangle color="black" align="left" width="$(wid)">
                <label name="$(name)" text="$(nome)" top="5"
                    horzTextAlign="center">
                </label>
                <event name="onClick">
                    require("templates_script.lua").rollQuadribol(self, sheet, "$(name)", "$(total)")
                </event>
            </rectangle>

            <edit field="$(atr)" align="left"
                margins="{left = 5}" width="30"
                horzTextAlign="center" readOnly="true" />
            <edit field="$(grad)" align="left"
                margins="{left = 5}" width="30"
                horzTextAlign="center" readOnly="true" />
            <edit field="$(out)" align="left"
                margins="{left = 5}" width="30"
                horzTextAlign="center" />
            <label field="$(total)" align="left"
                margins="{left = 5}" width="30"
                horzTextAlign="center" />
        </layout>
    </template>

    <template name="Guia">
        <layout height="30" align="top" margins="{top=3}">
            <label text="$(name)" top="5"
                horzTextAlign="center" align="left" />
            <label text="$(atr)" align="left"
                margins="{left = 5}" width="30"
                horzTextAlign="center" />
            <label text="$(grad)" align="left"
                margins="{left = 5}" width="30"
                horzTextAlign="center" />
            <label text="$(out)" align="left"
                margins="{left = 5}" width="30"
                horzTextAlign="center" />
            <label text="$(total)" align="left"
                margins="{left = 5}" width="30"
                horzTextAlign="center" />
        </layout>
    </template>

    <template name="Atributo">
        <rectangle padding="{top=3,bottom=5}" align="top" height="35"
            color="black">
            <label margins="{left=5}" align="left" horzTextAlign="center"
                width="100" text="$(text1)" name="$(name)" />
            <edit margins="{left=5}" align="left" horzTextAlign="center"
                width="40" field="$(field1)" />
            <edit margins="{left=5}" align="left" horzTextAlign="center"
                width="40" field="$(field2)"
                hint="Alternativa: substitui o MOD na rolagem do atributo. Deixe em branco para usar o MOD; zero também substitui." />
            <event name="onClick">
                require("templates_script.lua").rollAtributo(self, sheet, "$(name)", "$(field1)", "$(field2)")
            </event>
        </rectangle>
    </template>
</form>
