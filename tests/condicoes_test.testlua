test("Feitiço Poderoso permite C10 sem alterar o limite de quem não tem o talento", function()
    local root = fresh(); local node = popupSpell(root)
    local normal = lancamento.novo(node)
    equal(normal:limite(), 4)
    equal(normal:aumentar("Ataque"), true); equal(normal:aumentar("Ataque"), true)
    equal(normal:aumentar("Ataque"), false)
    node.talentoFeiticoPoderoso = true
    local powerful = lancamento.novo(node)
    equal(powerful:limite(), 10)
    for index = 1, 5 do equal(powerful:aumentar("Ataque"), true); equal(powerful:concentracao(), index * 2) end
    equal(powerful:aumentar("Dano"), false); equal(powerful:aumentar("Ataque"), false)
    equal(powerful:diminuir("Ataque"), true); equal(powerful:concentracao(), 8)
    equal(powerful:aumentar("Dano"), true); equal(powerful:concentracao(), 10)
    equal(node.Ataque, 1); equal(node.Dano, 10)
    equal(lancamento.novo(node):concentracao(), 0)
    node.talentoFeiticoPoderoso, node.talentoAtaquePoderoso = false, true
    equal(lancamento.novo(node):limite(), 4) -- Os dois talentos Poderosos são independentes.
end)

test("novo talento fica marcado e a janela mostra C10 e bloqueia o sexto aumento", function()
    local root = fresh(); local node = popupSpell(root)
    local context = {boxDetalhesDoItem = {node = node}, resumoTalentos = {text = ""}}
    feiticos.abrirTalentos(context, node)
