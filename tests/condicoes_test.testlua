end)

test("crítico usa o D20 natural: 20 normal e 19–20 com o talento, sem críticos por bônus", function()
    for _, scenario in ipairs({{false, 19, false}, {false, 20, true}, {true, 18, false}, {true, 19, true}, {true, 20, true}}) do
        local root = fresh({concentracao = 0}); local node = spell(root, "Ataque")
        node.talentoCritico = scenario[1]
        dice = {12, scenario[2]}
        feiticos.rolarFeitico({boxDetalhesDoItem = {node = node}}, node)
        equal(messageContains("Crítico!"), scenario[3])
    end
    equal(talentos.critico({talentoCritico = true}, {resultado = 100,
        ops = {{tipo = "dado", face = 20, resultados = {1}}}}), false)
end)

test("Feitiço Potente permanece ativo, não acumula ao reabrir e respeita a base do popup", function()
    local root = fresh(); local node = popupSpell(root)
    node.talentoAtaquePoderoso = true
    for _ = 1, 3 do
        local state = lancamento.novo(node)
        equal(state.preview.Dano, 11); equal(state.preview.Poder, 3); equal(state:concentracao(), 0)
        equal(talentos.feiticoEfetivo(state.preview).Dano, 11)
        equal(state:aumentar("Dano"), true); equal(state.preview.Dano, 21)
        equal(state:concentracao(), 2)
        equal(state:diminuir("Dano"), true); equal(state.preview.Dano, 11)
        equal(state:diminuir("Dano"), false)
        equal(node.Dano, 10); equal(node.Poder, 2)
    end
    local effective = talentos.feiticoEfetivo(node)
    equal(effective.Dano, 11); equal(talentos.feiticoEfetivo(effective).Dano, 11)
    local context = {boxDetalhesDoItem = {node = node}}
    assert(feiticos.stats(context, node):find("Dano: [§K1]11", 1, true))
    node.talentoAtaquePoderoso = false
    equal(lancamento.novo(node).preview.Dano, 10)
end)

test("Feitiço Potente melhora componentes existentes sem inventar dano em feitiços sem dano", function()
    local node = {talentoAtaquePoderoso = true, Dano = 0, Dano_array = "{0}", Poder = 1, Poder_array = "{1,2,3}"}
    equal(talentos.feiticoEfetivo(node).Dano, 0)
    equal(talentos.feiticoEfetivo(node).Poder, 2)
    node.Dano_array = "{0,1,2,3}"
    equal(talentos.feiticoEfetivo(node).Dano, 1)
    node.Poder = "-5 em Ataque"
    equal(talentos.feiticoEfetivo(node).Poder, "-5 em Ataque")
end)

test("Mente Calma reduz apenas a CDF temporária e funciona em Cast e Defesa, sem ataque", function()
    local root = fresh()
    for _, kind in ipairs({"Cast", "Defesa", "Ataque", "Ataque Base"}) do
        local node = popupSpell(root)
        node.tipo, node.talentoMenteCalma = kind, true
        local state = lancamento.novo(node)
        equal(state.menteCalma, false); equal(state.preview.CD, 10)
        state:definirMenteCalma(true)
        equal(state.preview.CD, (kind == "Cast" or kind == "Defesa") and 7 or 10)
        equal(state:concentracao(), 0); equal(node.CD, 10)
        state:definirMenteCalma(false); equal(state.preview.CD, 10)
    end
    local node = popupSpell(root); node.tipo = "Cast"
    local state = lancamento.novo(node); state:definirMenteCalma(true)
    equal(state.preview.CD, 10) -- Não permite usar sem aprender o talento.
end)

test("silêncio é opcional por lançamento, custa −5 normalmente e −2 com o talento", function()
    local root = fresh({concentracao = 0, C_FEI_Total = 8})
    for _, enabled in ipairs({false, true}) do
        local node = popupSpell(root); node.talentoSilencioso = enabled
        local state = lancamento.novo(node)
        equal(state:penalidadeSilenciosa(), 0)
        state:definirSilencioso(true)
        equal(state:penalidadeSilenciosa(), enabled and -2 or -5)
        state:definirSilencioso(false); equal(state:penalidadeSilenciosa(), 0)
        feiticos.rolarFeitico({boxDetalhesDoItem = {node = node}}, node, nil,
            {node = state.preview, root = root, concentracao = 0, silencioso = true})
        equal(evaluate(parsed[#parsed - 1]), enabled and 25 or 22)
    end
end)

