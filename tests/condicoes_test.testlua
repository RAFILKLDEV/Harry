end)

test("envio do resumo tem duas linhas e textos completos continuam disponíveis por campo", function()
    local root = fresh(); local node = popupSpell(root)
    node.Desc = "Descrição completa\ncom várias linhas\n" .. string.rep("detalhes ", 80)
    node.Efeito, node.defesa, node.Bonus = "Luz\nativa", "Acerto + Vontade", "+2\nno teste"
    local context = {boxDetalhesDoItem = {node = node}, popUp = {visible = true}}
    equal(feiticos.enviarFeiticoNaMesa(context, node), true)
    equal(#messages, 1)
    local _, breaks = messages[1]:gsub("\n", "")
    equal(breaks, 1)
    assert(not messageContains("Luz ativa")); assert(messageContains("Testes: Acerto + Vontade"))
    assert(not messageContains("Descrição completa")); equal(context.popUp.visible, false)
    equal(feiticos.enviarCampoNaMesa(context, node, "Desc"), true)
    assert(messages[2]:find("Descrição completa com várias linhas", 1, true))
    assert(messages[2]:find(string.rep("detalhes ", 75), 1, true))
    assert(not messages[2]:find("\n", 1, true))
    equal(feiticos.enviarCampoNaMesa(context, node, "campoDesconhecido"), false)
    equal(#messages, 2)
end)

test("mensagem compacta ainda identifica o personagem e o feitiço", function()
    local root = fresh({nomePersonagem = "Hermione", concentracao = 0})
    local node = spell(root, "Cast"); node.nome = "Lumos"
    feiticos.rolarFeitico({boxDetalhesDoItem = {node = node}}, node)
    assert(messageContains("Lumos · Hermione · ✓ Sucesso"))
    equal(#messages, 1)
end)

local function plainMessage(value)
    return (value:gsub("%[§[^%]]*%]", ""))
end
local function messageLines(value)
    local result = {}
    for line in value:gmatch("[^\n]+") do result[#result + 1] = line end
    return result
end

test("Protego segue exatamente as quatro linhas e as somas do formato solicitado", function()
    local root = fresh({nomePersonagem = "Samsara", concentracao = 0, C_FEI_Total = 6, APA_Total = 51})
    local node = spell(root, "Defesa")
    node.nome, node.Grad, node.CD, node.Poder = "Protego", 10.0, 11.0, 4.0
    node.Range, node.tempo, node.Dano, node.Area, node.Duracao = "Pessoal", "Reação", 0, 0, 0
    dice, choices = {12, 4}, {"Corpo-a-Corpo"}
    feiticos.rolarFeitico({boxDetalhesDoItem = {node = node}}, node)
    equal(#messages, 1)
    equal(plainMessage(messages[1]), table.concat({
        "Protego · Samsara · ✓ Sucesso", "Conj: [ 12 ] +10 +3 = 25 | CD 11",
        "DEFESA: [ 4 ] +10 +4 +51 = 69", "Pessoal · Reação"
    }, "\n"))
    equal(parsed[1], "1d20+10+3"); equal(parsed[2], "1d8+10+4+51")
end)

test("Estupefaça mostra a soma original e a seta até o mínimo real de Mestre em Ataque", function()
    local root = fresh({nomePersonagem = "Samsara", concentracao = 0, C_FEI_Total = 6, DES = 5})
    local node = spell(root, "Ataque")
    node.nome, node.Grad, node.CD, node.Ataque, node.Dano, node.Poder = "Estupefaça", 10, 12, 2, 10, 0
    node.Range, node.defesa, node.talentoMaestriaSuperior = "7.5m", "Fortitude", true
    dice = {3, 1}
    feiticos.rolarFeitico({boxDetalhesDoItem = {node = node}}, node)
    equal(plainMessage(messages[1]), table.concat({
        "Estupefaça · Samsara · ✓ Sucesso", "Conj: [ 3 ] +10 +3 = 16 | CD 12",
        "ATAQUE: [ 1 ] +10 +5 +2 = 18 → 27", "Mestre em Ataque (mín.) · Dano 10 · 7,5m · Fortitude",
        "Mestre em Ataque"
    }, "\n"))
    equal(parsed[1], "1d20+10+3"); equal(parsed[2], "1d20+10+5+2")
    assert(messages[1]:find(mensagensMagia.cores.branco .. " = 18 → " .. mensagensMagia.cores.amarelo .. "27", 1, true))
    equal(node.Dano, 10); equal(node.CD, 12)
end)

test("cada parcela recebe a cor nativa correta sem agregar bônus ou penalidades", function()
    local roll = {resultado = 14.0, ops = {{tipo = "dado", face = 20, resultados = {12.0}}}}
    local output = mensagensMagia.calculo("Conj", roll, {10, 3, -5, -4, -2, 0})
    equal(plainMessage(output), "Conj: [ 12 ] +10 +3 -5 -4 -2 = 14")
    local color = mensagensMagia.cores
    assert(output:find(color.azul .. "Conj: " .. color.branco .. "[ 12 ]", 1, true))
    assert(output:find(color.ciano .. "+10 " .. color.ciano .. "+3", 1, true))
    assert(output:find(color.vermelho .. "-5 " .. color.vermelho .. "-4 " .. color.vermelho .. "-2", 1, true))
    assert(output:find(color.amarelo .. "14" .. color.branco, 1, true))
    assert(not output:find("+0", 1, true))
    local _, blocks = output:gsub("%[§K#67E8F9%]", "")
    equal(blocks, 2)
end)

test("nome do personagem é rosa, sucesso verde e falha vermelha sem HTML ou Markdown", function()
    local context = {nome = "Lumos", personagem = "Samsara", node = {Dano = 5, Range = "7,5m", defesa = "Fortitude"}, cd = 10,
        conjuracao = {resultado = 15, ops = {{tipo = "dado", face = 20, resultados = {12}}}}, modificadoresConjuracao = {3}}
    local output = mensagensMagia.formatar(context)
    local color = mensagensMagia.cores
    assert(output:find(color.lavanda .. "Lumos" .. color.branco, 1, true))
    assert(output:find(color.lavanda .. "CD 10" .. color.branco, 1, true))
    assert(output:find(color.pessego .. "Dano 5" .. color.branco, 1, true))
    assert(output:find(color.suave .. "7,5m" .. color.branco, 1, true))
    assert(output:find(color.lavanda .. "Fortitude" .. color.branco, 1, true))
    assert(output:find(color.rosa .. "Samsara" .. color.branco, 1, true))
    assert(output:find(color.verde .. "✓ Sucesso" .. color.branco, 1, true))
    assert(not output:find("<", 1, true)); assert(not output:find("**", 1, true))
    context.falha, context.estagios = true, 2
    output = mensagensMagia.formatar(context)
    assert(output:find(color.vermelho .. "✗ Falha (2 estágios)" .. color.branco, 1, true))
    equal(#messageLines(output), 2)
end)

test("campos ausentes e efeitos de um Cast que falhou não geram linhas irrelevantes", function()
    local context = {nome = "Teste", personagem = "Samsara", node = {Dano = 0, Poder = 0, Range = "-", Duracao = 0, defesa = ""},
        cd = 10, conjuracao = {resultado = 2, ops = {}}, modificadoresConjuracao = {1}}
    equal(#messageLines(mensagensMagia.formatar(context)), 2)
    context.falha, context.estagios = true, 4
    context.node.Dano, context.node.Range, context.node.defesa = 10, "7.5m", "Fortitude"
    local output = plainMessage(mensagensMagia.formatar(context))
    equal(#messageLines(output), 2)
    assert(not output:find("Dano", 1, true)); assert(not output:find("Fortitude", 1, true))
    context.node.talentoMaestria, context.estagios = true, 1
    assert(plainMessage(mensagensMagia.formatar(context)):find("Mestre em Conjuração", 1, true))
end)

test("mínimo não aplicado não cria seta e crítico continua baseado no dado natural", function()
    local root = fresh({nomePersonagem = "Samsara", concentracao = 0, C_FEI_Total = 6, DES = 5})
    local node = spell(root, "Ataque")
    node.Grad, node.CD, node.Ataque, node.talentoMaestriaSuperior, node.talentoCritico = 10, 12, 2, true, true
    dice = {12, 19}
    feiticos.rolarFeitico({boxDetalhesDoItem = {node = node}}, node)
    assert(messageContains("ATAQUE: [ 19 ] +10 +5 +2 = 36 | Crítico!"))
    assert(messageContains("Mestre em Ataque (mín. 27)"))
    assert(not messages[1]:find("→", 1, true))
    equal(#messageLines(messages[1]), 5)
end)

test("conjuração identifica o crítico natural em todos os tipos de feitiço", function()
    for _, kind in ipairs({"Cast", "Ataque", "Defesa"}) do
        for _, scenario in ipairs({{false, 19, false}, {false, 20, true}, {true, 18, false}, {true, 19, true}}) do
            local root = fresh({C_FEI_Total = 20})
            local node = spell(root, kind)
            node.talentoCritico = scenario[1]
            dice, choices = {scenario[2], kind == "Defesa" and 8 or 12}, {"Distância"}
            feiticos.rolarFeitico({boxDetalhesDoItem = {node = node}}, node)
            local lines = messageLines(messages[1])
            local marker = mensagensMagia.cores.dourado .. "Crítico!" .. mensagensMagia.cores.branco
            equal(lines[2]:find(marker, 1, true) ~= nil, scenario[3])
            equal(messageContains("Crítico!"), scenario[3])
            equal(#parsed, kind == "Cast" and 1 or 2)
        end
    end
end)

test("conjuração e ataque críticos aparecem em dourado nas respectivas linhas", function()
    local root = fresh({C_FEI_Total = 8})
    local node = spell(root, "Ataque")
    dice = {20, 20}
    feiticos.rolarFeitico({boxDetalhesDoItem = {node = node}}, node)
    local lines = messageLines(messages[1])
    local marker = mensagensMagia.cores.dourado .. "Crítico!" .. mensagensMagia.cores.branco
    assert(lines[2]:find(marker, 1, true)); assert(lines[3]:find(marker, 1, true))
    equal(plainMessage(lines[2]), "Conj: [ 20 ] +2 +4 = 26 | CD 5 | Crítico!")
    equal(plainMessage(lines[3]), "ATAQUE: [ 20 ] +2 +3 +1 = 26 | Crítico!")
    equal(#parsed, 2); equal(#sentMessages, 2)
    assert(#lines <= 4)
end)

test("Muro Fictus rola Furtividade após conjurar com sucesso usando a perícia e a condição física", function()
    for _, scenario in ipairs({{false, 0}, {true, -5}}) do
        local root = fresh({C_ENC_Total = 8, FUR_Total = 11, Exausto = scenario[1], Frustrado = true, fisico = 90})
        local node = spell(root, "Cast")
        node.nome, node.escola, node.CD, node.Poder = "Muro Fictus", "Encantamento", 18, 5
        local state = lancamento.novo(node)
        dice = {16, 7}
        local finished = 0
        feiticos.rolarFeitico({boxDetalhesDoItem = {node = node}}, node, function() finished = finished + 1 end,
            {node = state.preview, root = root, concentracao = 0})
        equal(parsed[1], "1d20+2+4-2") -- Frustrado afeta somente a conjuração.
        equal(parsed[2], "1d20+11" .. (scenario[2] == 0 and "" or "-5"))
        local lines = messageLines(messages[1])
        equal(plainMessage(lines[3]), scenario[1] and "FURTIVIDADE: [ 7 ] +11 -5 = 13" or "FURTIVIDADE: [ 7 ] +11 = 18")
        equal(#parsed, 2); equal(#sentMessages, 2); equal(finished, 1)
        equal(sentMessages[1], mensagensMagia.separador)
        assert(#lines <= 4)
        equal(node.Poder, 5); equal(root.FUR_Total, 11)
    end
end)

test("Muro Fictus com conjuração falha e outras magias Cast não rolam Furtividade", function()
    for _, name in ipairs({"Muro Fictus", "Lumos"}) do
        local root = fresh({C_ENC_Total = 8, FUR_Total = 11})
        local node = spell(root, "Cast")
        node.nome, node.escola, node.CD = name, "Encantamento", 18
        dice = {name == "Muro Fictus" and 1 or 20}
        feiticos.rolarFeitico({boxDetalhesDoItem = {node = node}}, node)
        equal(#parsed, 1); equal(#sentMessages, 2)
        assert(not messageContains("FURTIVIDADE:"))
        equal(messageContains("Falha"), name == "Muro Fictus")
    end
end)

test("importação de feitiço preserva o tempo de lançamento", function()
    local originalLoad, originalChildren, originalChoose = NDB.load, NDB.getChildNodes, Dialogs.choose
    local catalog = {f1 = {
        nome = "Importado", escola = "Encantamento", cast = "Cast", tempo = "Concentração",
        defesa = "Poder", efeito = "Efeito", bonus = "0", desc = "Descrição",
        gradArray = "{0,1}", cdfArray = "{12,11}", danoArray = "{0}",
        poderArray = "{1,2}", rangeArray = "{'3m','6m'}", areaArray = "{0}", duracaoArray = "{0}"
    }}
    NDB.load = function() return catalog end
    NDB.getChildNodes = function() return {catalog.f1} end
    Dialogs.choose = function(_, _, callback) callback(true, 1, "Importado") end
    local node = {nome = "Antigo", _root = fresh()}
    local context = {boxDetalhesDoItem = {node = node}}
    local ok, reason = pcall(function() feiticos.ListaDeFeitico(context, node) end)
    NDB.load, NDB.getChildNodes, Dialogs.choose = originalLoad, originalChildren, originalChoose
    assert(ok, reason)
    equal(node.nome, "Importado"); equal(node.tempo, "Concentração"); equal(node.tipo, "Cast")
    equal(node.Poder, 1); equal(node.Poder_array, "{1,2}")
end)

test("abas de anotações podem ser renomeadas e mantêm o título na ficha", function()
    local root = fresh(); local aba = {title = "Primeira Aba"}
    inputs = {"  Combate   "}
    anotacoes.renomearAba(aba, root, "tituloAnotacao1")
    equal(root.tituloAnotacao1, "Combate"); equal(aba.title, "Combate")
    local controles = {abaAnotacao1 = {title = "Primeira Aba"}, abaAnotacao2 = {title = "Segunda Aba"}}
    local form = {findControlByName = function(_, name) return controles[name] end}
    anotacoes.aplicarTitulos(form, root)
    equal(controles.abaAnotacao1.title, "Combate"); equal(controles.abaAnotacao2.title, "Segunda Aba")
end)

test("Avada Kedrava respeita a regra do catálogo e não pode critar", function()
    local node = {nome = "Avada Kedrava", talentoCritico = true}
    equal(talentos.critico(node, {ops = {{tipo = "dado", face = 20, resultados = {20}}}}), false)
end)

test("formatador aceita outros resultados já calculados, inclusive cura e frações", function()
    fresh()
    local context = {nome = "Cura", personagem = "Samsara", node = {Range = "Toque"}, cd = 10,
        conjuracao = {resultado = 14, ops = {{tipo = "dado", resultados = {10}}}}, modificadoresConjuracao = {4},
        principal = {titulo = "CURA", rolagem = {resultado = 8.5, ops = {{tipo = "dado", resultados = {4}}}},
                     modificadores = {5, -0.5}, final = 10.5}}
    local output = plainMessage(mensagensMagia.formatar(context))
    assert(output:find("CURA: [ 4 ] +5 -0,5 = 8,5 → 10,5", 1, true))
    equal(#parsed, 0); equal(#rolls, 0); equal(#controls, 0) -- Apresentação não cria rolagens nem interface.
end)

test("defesa assíncrona cancelada preserva o Cast e não inventa uma rolagem principal", function()
    local root = fresh({concentracao = 0}); local node = spell(root, "Defesa")
    local originalChoose, pending, finished = Dialogs.choose, nil, 0
    Dialogs.choose = function(_, _, callback) pending = callback end
    local ok, reason = pcall(function()
        feiticos.rolarFeitico({boxDetalhesDoItem = {node = node}}, node, function() finished = finished + 1 end)
        equal(#parsed, 1); equal(#messages, 0)
        equal(#sentMessages, 0)
        assert(pending); pending(false)
    end)
    Dialogs.choose = originalChoose
    assert(ok, reason)
    equal(#parsed, 1); equal(#messages, 1); equal(finished, 1)
    equal(#sentMessages, 2)
    equal(sentMessages[1], "------------------------------------")
    equal(sentMessages[2], messages[1])
    assert(messageContains("Conj:")); assert(not messageContains("DEFESA:"))
end)

test("cada rolagem envia um separador antes do bloco principal, inclusive nas falhas", function()
    local root = fresh({nomePersonagem = "Samsara", concentracao = 0})
    local node = spell(root, "Cast"); node.nome = "Lumos"
    feiticos.rolarFeitico({boxDetalhesDoItem = {node = node}}, node)
    node.nome, node.CD, dice = "Nox", 100, {1}
    feiticos.rolarFeitico({boxDetalhesDoItem = {node = node}}, node)
    equal(#sentMessages, 4); equal(#messages, 2)
    equal(sentMessages[1], "------------------------------------")
    equal(sentMessages[3], "------------------------------------")
    assert(plainMessage(sentMessages[2]):find("Lumos · Samsara · ✓ Sucesso", 1, true))
    assert(plainMessage(sentMessages[4]):find("Nox · Samsara · ✗ Falha", 1, true))
    equal(sentMessages[2], messages[1]); equal(sentMessages[4], messages[2])
    assert(not messages[1]:find(mensagensMagia.separador, 1, true))
end)

test("a paleta RGB usa tags hexadecimais nativas e não altera envios que não são rolagens", function()
    local seen = {}
    for _, color in pairs(mensagensMagia.cores) do
        assert(color:match("^%[§K#%x%x%x%x%x%x%]$"), color)
        assert(not seen[color]); seen[color] = true
    end
    local root = fresh(); local node = popupSpell(root)
    equal(feiticos.enviarFeiticoNaMesa({boxDetalhesDoItem = {node = node}}, node), true)
    equal(#sentMessages, 1)
    assert(sentMessages[1] ~= mensagensMagia.separador)
    sentMessages, messages = {}, {}
    node.CD = "inválida"
    feiticos.rolarFeitico({boxDetalhesDoItem = {node = node}}, node)
    equal(#sentMessages, 0)
end)

print(string.format("%d testes passaram; %d falharam.", passed, failed))
if failed > 0 then os.exit(1) end
