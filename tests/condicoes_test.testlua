    equal(checkbox("Feitiço Poderoso").checked, true)
    controls = {}; feiticos.abrirPopupFeitico(context, node)
    equal(concentrationText(), "Concentração temporária: C0 / C10")
    for _ = 1, 5 do row("Ataque").plus.onClick() end
    equal(concentrationText(), "Concentração temporária: C10 / C10")
    equal(row("Ataque").plus.enabled, false); equal(row("Dano").plus.enabled, false)
    row("Ataque").plus.onClick(); equal(row("Ataque").value.text, "6")
    controls = {}; feiticos.abrirPopupFeitico(context, node)
    equal(concentrationText(), "Concentração temporária: C0 / C10")
    equal(row("Ataque").value.text, "1")
end)

test("lançamentos com talentos usam uma última linha dourada e até cinco linhas", function()
    local root = fresh({concentracao = 0, C_FEI_Total = 8, Exausto = true, Frustrado = true, acerto = 1})
    local node = popupSpell(root)
    node.talentoMaestria, node.talentoMaestriaSuperior, node.talentoMenteCalma = true, true, true
    node.talentoCritico, node.talentoAtaquePoderoso = true, true
    node.talentoFeiticoPoderoso, node.talentoSilencioso = true, true
    node.Desc, node.Efeito, node.defesa = "Texto de descrição extenso", "Texto de efeito extenso", "Fortitude"
    local state = lancamento.novo(node)
    for _ = 1, 5 do state:aumentar("Ataque") end
    dice = {20, 19}
    feiticos.rolarFeitico({boxDetalhesDoItem = {node = node}}, node, nil,
        {node = state.preview, root = root, concentracao = state:concentracao(), silencioso = true})
    equal(#messages, 1)
    assert(messageContains("Mestre em Ataque (mín. 16)"))
    assert(messageContains("Mestre em Conjuração · Mestre em Ataque · Mente Calma"))
    assert(messageContains("Feitiço Silencioso · Crítico Aprimorado · Feitiço Potente · Feitiço Poderoso"))
    assert(messageContains("Conj: [ 20 ] +3 +4 -10 -2 -2 = 13 | CD 10"))
    assert(messageContains("ATAQUE: [ 19 ] +3 +3 +6 -1 -5 = 25 | Crítico!"))
    assert(messageContains("Dano 11 · Poder 3"))
    assert(messageContains("Fortitude"))
    assert(not messageContains("Texto de descrição")); assert(not messageContains("Texto de efeito"))
    for _, message in ipairs(messages) do
        local plain = message:gsub("%[§[^%]]*%]", "")
        local lineCount = 0
        for line in plain:gmatch("[^\n]+") do lineCount = lineCount + 1; assert(#line <= 200, line) end
        assert(lineCount <= 5)
        assert(plain:match("[^\n]+$") == "Mestre em Conjuração · Mestre em Ataque · Mente Calma · Feitiço Silencioso · Crítico Aprimorado · Feitiço Potente · Feitiço Poderoso")
        local ultimaLinha = message:match("[^\n]+$")
        assert(ultimaLinha:find(mensagensMagia.cores.dourado .. "Mestre em Conjuração", 1, true))
        assert(not ultimaLinha:find("Talentos:", 1, true))
    end
end)

