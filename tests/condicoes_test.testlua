-- Suíte executada somente pelo runner externo; extensão não carregada pelo Firecast.
-- O Firecast aceita require com a extensão .lua, diferente do loader padrão.
table.insert(package.searchers, 2, function(name)
    if name:match("%.lua$") then
        local loader, reason = loadfile(name)
        return loader or reason
    end
    return "\n\tfora do loader de arquivos Firecast"
end)
local rolls, parsed, messages, actions, controls = {}, {}, {}, {}, {}
local sentMessages = {}
local choices, inputs, room = {}, {}, nil
local dice = {}
local function evaluate(expression)
    local value = expression:gsub("1d20", "20"):gsub("1d8", "8")
    assert(value:match("^[%d%+%-%s%.]+$"), expression)
    return assert(load("return " .. value))()
end
local chat = {}
function chat:rolarDados(expression, message, callback)
    expression = type(expression) == "table" and expression.expression or expression
    local result = evaluate(expression)
    rolls[#rolls + 1] = {expression = expression, message = message, result = result}
    if callback then callback({resultado = result}) end
end
function chat:enviarMensagem(message)
    sentMessages[#sentMessages + 1] = message
    -- Os testes de conteúdo analisam o bloco; os testes de envio verificam
    -- separadamente a ordem de todas as mensagens, incluindo o separador.
    if message ~= "------------------------------------" then messages[#messages + 1] = message end
end
function chat:enviarAcao(message) actions[#actions + 1] = message end
rrpg = {
    getMesaDe = function() return room end,
    interpretarRolagem = function(expression)
        parsed[#parsed + 1] = expression
        return {expression = expression, ops = {}, rolarLocalmente = function(self)
            local face = expression:find("1d8", 1, true) and 8 or 20
            local natural = table.remove(dice, 1) or face
            local bonus = evaluate(expression) - face
            self.resultado = natural + bonus
            self.ops = {{tipo = "dado", face = face, resultados = {natural}}, {tipo = "imediato", valor = bonus}}
        end}
    end
}
Firecast = {getRoomOf = function() return room end}
NDB = {
    getRoot = function(node) return node and (node._root or node) end,
    load = function() return {f1 = {nome = "Feitiço de teste", cdfArray = {10}}} end,
    getChildNodes = function(node) return node.f1 and {node.f1} or {} end
}
Dialogs = {
    choose = function(_, options, callback)
        local text = table.remove(choices, 1)
        if text == false then return callback(false) end
        for index, option in ipairs(options) do
            if option == text then return callback(true, index, text) end
        end
        error("Escolha inesperada: " .. tostring(text))
    end,
    inputQuery = function(_, _, _, callback) callback(table.remove(inputs, 1)) end,
    showMessage = function(message) messages[#messages + 1] = message end
}
showMessage = Dialogs.showMessage
local function control(kind)
    local item = {kind = kind}
    function item:close() self.closed = true end
    function item:show() self.shown = true end
    controls[#controls + 1] = item
    return item
end
GUI = {}
for _, kind in ipairs({"PopupForm", "Layout", "Label", "Edit", "Button", "CheckBox", "ScrollBox"}) do
    GUI["new" .. kind] = function() return control(kind) end
end
package.preload["ndb.lua"] = function() return NDB end
package.preload["dialogs.lua"] = function() return Dialogs end
package.preload["gui.lua"] = function() return GUI end
package.preload["utils.lua"] = function()
    totable = function(value)
        if type(value) == "string" then return assert(load("return " .. value))() end
        return value
    end
    return true
end
local condicoes = require("condicoes.lua")
local templates = require("templates_script.lua")
local tarefas = require("tarefas_script.lua")
local feiticos = require("feitico_script.lua")
local lancamento = require("lancamento.lua")
local talentos = require("talentos.lua")
local mensagensMagia = require("mensagens_magia.lua")
local anotacoes = require("anotacoes_script.lua")
local function fresh(values)
    rolls, parsed, messages, actions, controls, choices, inputs = {}, {}, {}, {}, {}, {}, {}
    sentMessages = {}
    dice = {}
    room = {chat = chat, meuJogador = {nick = "Teste"}}
    local root = {nomePersonagem = "Teste", AGI = 2, DES = 3, FOR = 4, LUT = 5, VIG = 6,
                  INTE = 8, PRE = 1, SAB = 7, fisico = 3, mental = 4,
                  ACR_Total = 7, CON_Total = 9, APA_Total = 9, REF_Total = 7,
                  FORT_Total = 9, VON_Total = 8, RES_Total = 9}
    for key, value in pairs(values or {}) do root[key] = value end
    return root
end
local function equal(actual, expected)
    assert(actual == expected, "esperado " .. tostring(expected) .. ", recebido " .. tostring(actual))
end
local passed, failed = 0, 0
local function test(name, callback)
    local ok, reason = xpcall(callback, debug.traceback)
    if ok then passed = passed + 1; print("OK: " .. name)
    else failed = failed + 1; print("FALHOU: " .. name .. "\n" .. reason) end
end

test("condições globais usam a raiz, mantêm os grupos separados e não acumulam graus", function()
    local root = fresh({Fadigado = true, Exausto = true, Frustrado = true, Tiltado = true})
    equal(condicoes.penalidade({_root = root}, "fisico"), -5)
    equal(condicoes.penalidade({_root = root}, "mental"), -5)
    root.Exausto, root.Tiltado = false, false
    equal(condicoes.penalidade(root, "fisico"), -2)
    equal(condicoes.penalidade(root, "mental"), -2)
    root.Fadigado, root.Frustrado = false, false
    equal(condicoes.penalidade(root, "fisico"), 0)
    equal(condicoes.penalidade(root, "mental"), 0)
    equal(condicoes.penalidade(nil, "fisico"), 0)
end)

test("todos os oito atributos aplicam o grupo correto e ignoram os campos de treino", function()
    local root = fresh({Fadigado = true, Tiltado = true, fisico = 90, mental = 80})
    for _, attribute in ipairs({"AGI", "DES", "FOR", "LUT", "VIG", "INTE", "PRE", "SAB"}) do
        templates.rollAtributo({label = {text = attribute}}, root, "label", attribute, "alternativa")
        local penalty = condicoes.tipoDoAtributo(attribute) == "fisico" and -2 or -5
        equal(rolls[#rolls].result, 20 + root[attribute] + penalty)
    end
    root.alternativa = 0
    templates.rollAtributo({label = {text = "Força"}}, root, "label", "FOR", "alternativa")
    equal(rolls[#rolls].result, 18)
end)

test("perícias, defesas e quadribol aplicam apenas condições do grupo correspondente", function()
    local root = fresh({Exausto = true, Frustrado = true, fisico = 90, mental = 80})
    for _, name in ipairs({"Acrobacia", "Atletismo", "Corpo-a-Corpo", "Furtividade", "Prestidigitação",
                            "Veiculos Mágicos", "Iniciativa", "Aparar", "Fortitude", "Reflexo", "Resistencia"}) do
        templates.rollLabelComEdit({label = {text = name}}, root, "label", "ACR_Total")
        equal(rolls[#rolls].result, 22)
    end
    templates.rollLabelComEdit({label = {text = "Concentração"}}, root, "label", "CON_Total")
    equal(rolls[#rolls].result, 27)
    root.quad = 10
    for _, name in ipairs({"Antecipar", "Atrapalhar", "Marcar Falta", "Apanhar Pomo", "Defender", "Driblar"}) do
        templates.rollQuadribol({label = {text = name}}, root, "label", "quad")
        local mental = name == "Antecipar" or name == "Atrapalhar" or name == "Marcar Falta"
        equal(rolls[#rolls].result, 30 - (mental and 2 or 5))
    end
end)

test("perícias personalizadas consultam as condições da ficha principal", function()
    local root = fresh({Exausto = true, Frustrado = true})
    local child = {_root = root, ATRIBUTO = "DES", TOTAL = 11, NOME = "Perícia personalizada"}
    templates.rollOtherSkill({}, child); equal(rolls[#rolls].result, 26)
    child.ATRIBUTO = "INTE"
    templates.rollOtherSkill({}, child); equal(rolls[#rolls].result, 29)
    child.ATRIBUTO = nil
    templates.rollOtherSkill({}, child); equal(rolls[#rolls].result, 31)
end)

test("treinos de atributos, prática e estudo somam uma vez o campo local e a condição global", function()
    for _, scenario in ipairs({
        {{"Atributo", "Força"}, 21}, {{"Atributo", "Destreza"}, 21}, {{"Atributo", "Vigor"}, 21},
        {{"Atributo", "Inteligencia"}, 22}, {{"Atributo", "Sabedoria"}, 22}, {{"Atributo", "Presença"}, 22},
        {{"Praticar"}, 21}, {{"Estudar"}, 22},
        {{"Praticar Feitiços", "Feitiço de teste"}, 21}, {{"Estudar Feitiços", "Feitiço de teste"}, 22}
    }) do
        local root = fresh({Fadigado = true, Frustrado = true})
        choices, inputs = scenario[1], {"15"}
        tarefas.treinar(root)
        equal(#rolls, 1); equal(rolls[1].result, scenario[2])
        assert(rolls[1].message:find("CD "))
        assert(not rolls[1].message:find(" = ")) -- a CD não recebe a penalidade de novo
        equal(root.fisico, 3); equal(root.mental, 4)
    end
end)

test("exaustão afeta treino físico e tilt afeta estudo, incluindo resultados negativos", function()
    local root = fresh({Exausto = true, Tiltado = true})
    choices, inputs = {"Praticar"}, {"15"}; tarefas.treinar(root)
    equal(rolls[1].result, 18)
    choices, inputs = {"Estudar"}, {"15"}; tarefas.treinar(root)
    equal(rolls[2].result, 19)
    root.fisico = 50
    choices, inputs = {"Praticar"}, {"15"}; tarefas.treinar(root)
    equal(rolls[3].result, -29)
end)

local function spell(root, kind)
    return {_root = root, nome = "Teste", tipo = kind, escola = "Feitiço", Grad = 2,
            CD = 5, Ataque = 1, Poder = 2}
end
test("conjuração e ataque usam condições globais sem incluir os números de treino", function()
    local root = fresh({Exausto = true, Frustrado = true, C_FEI_Total = 8, concentracao = 1,
                        acerto = 1, fisico = 90, mental = 80})
    local node = spell(root, "Ataque")
    feiticos.rolarFeitico({boxDetalhesDoItem = {node = node}}, node)
    equal(#parsed, 2); equal(evaluate(parsed[1]), 23); equal(evaluate(parsed[2]), 20)
    root.fisico, root.mental = 0, 0
    feiticos.rolarFeitico({boxDetalhesDoItem = {node = node}}, node)
    equal(evaluate(parsed[3]), 23); equal(evaluate(parsed[4]), 20)
end)

test("defesas mágicas corpo a corpo e à distância recebem a condição física", function()
    for _, kind in ipairs({"Corpo-a-Corpo", "Distância"}) do
        local root = fresh({Exausto = true, C_FEI_Total = 8, fisico = 90, mental = 80})
        local node = spell(root, "Defesa")
        choices = {kind}
        feiticos.rolarFeitico({boxDetalhesDoItem = {node = node}}, node)
        equal(evaluate(parsed[2]), kind == "Corpo-a-Corpo" and 24 or 22)
    end
end)

test("defesa oferece distância primeiro e confirmar o padrão usa Reflexos", function()
    local root = fresh({C_FEI_Total = 8, APA_Total = 40, REF_Total = 7})
    local node = spell(root, "Defesa")
    local originalChoose = Dialogs.choose
    Dialogs.choose = function(_, options, callback, defaultIndex)
        equal(options[1], "Distância"); equal(options[2], "Corpo-a-Corpo")
        equal(defaultIndex, 1)
        callback(true, defaultIndex, options[defaultIndex])
    end
    local ok, reason = pcall(function()
        feiticos.rolarFeitico({boxDetalhesDoItem = {node = node}}, node)
        equal(#parsed, 2); equal(evaluate(parsed[2]), 27) -- 1d8 + 10 + Poder 2 + REF 7.
    end)
    Dialogs.choose = originalChoose
    assert(ok, reason)
end)

local file = assert(io.open("defesas.xml", "rb")); local xml = file:read("*a"); file:close()
local defenseScript = assert(xml:match("<script>(.-)</script>")):gsub("&lt;", "<"):gsub("&gt;", ">")
assert(load(defenseScript, "@defesas.xml"))()
test("resistência a dano aplica condição física junto a ferimento e outro modificador", function()
    for _, state in ipairs({"Fadigado", "Exausto"}) do
        sheet = fresh({[state] = true, ferimentos = 1, fisico = 90})
        testeResistenciaDanoDialog()
        local edits, button = {}, nil
        for _, item in ipairs(controls) do
            if item.kind == "Edit" then edits[#edits + 1] = item end
            if item.kind == "Button" and item.text == "Rolar" then button = item end
        end
        edits[2].text = "2"
        assert(button).onClick()
        equal(rolls[1].result, state == "Fadigado" and 28 or 25)
    end
end)

test("testes de efeitos aplicam condição física ou mental conforme a defesa", function()
    for _, kind in ipairs({"Fortitude", "Reflexos", "Vontade"}) do
        sheet = fresh({Exausto = true, Frustrado = true, fisico = 90, mental = 80})
        choices, inputs = {kind}, {"3"}
        testeResistenciaEfeitoDialog()
        equal(rolls[1].result, ({Fortitude = 24, Reflexos = 22, Vontade = 26})[kind])
    end
end)

test("campos de treino preservam valores, normalizam o sinal e funcionam sem mesa", function()
    local root = fresh(); room = nil
    tarefas.trainingModifierChanged(root, "fisico", 3, -5)
    equal(root.fisico, 5); equal(#actions, 0)
    room = {chat = chat}
    tarefas.trainingModifierChanged(root, "mental", 4, -6)
    equal(root.mental, 6); equal(#actions, 1)
    tarefas.trainingModifierChanged(root, "mental", -6, 6)
    equal(#actions, 1)
    equal(condicoes.penalidade(root, "fisico"), 0)
    equal(condicoes.penalidade(root, "mental"), 0)
end)

test("cancelamento, CD inválida e ficha sem mesa não produzem rolagem", function()
    local root = fresh()
    choices = {false}; tarefas.treinar(root); equal(#rolls, 0)
    choices, inputs = {"Estudar"}, {"inválida"}; tarefas.treinar(root); equal(#rolls, 0)
    room = nil; tarefas.treinar(root); equal(#rolls, 0)
end)

test("trocar condições conserva os grupos separados e também funciona fora de uma mesa", function()
    local root = fresh({Fadigado = true, Exausto = true, Frustrado = true})
    room = nil
    templates.checkConditionChanged({Fadigado = {text = "Fatigado"}}, root, "Fadigado")
    equal(root.Exausto, nil); equal(root.Frustrado, true)
    root.Tiltado = true
    templates.checkConditionChanged({}, root, "Tiltado")
    equal(root.Frustrado, nil); equal(root.Fadigado, true)
    equal(condicoes.penalidade(root, "fisico"), -2)
    equal(condicoes.penalidade(root, "mental"), -5)
end)

local function popupSpell(root)
    local node = spell(root, "Ataque")
    node.Grad, node.CD, node.Dano, node.Area, node.Range, node.Duracao, node.Poder = 3.0, 10.0, 10.0, 1.5, "4.5m", 10.0, 2.0
    node.Dano_array, node.Area_array = {0.0, 10.0, 20.0, 30.0}, {0.0, 1.5, 3.0, 4.5}
    node.Range_array, node.Duracao_array = {"Toque", "4.5m", "6m", "7.5m"}, {0.0, 10.0, 20.0, 30.0}
    node.Poder_array = {1.0, 2.0, 3.0, 4.0}
    for _, field in ipairs({"Dano", "Area", "Range", "Duracao", "Poder", "Ataque"}) do node[field .. "_grad"] = 2.0 end
    return node
end
local function row(field)
    local parent
    for _, item in ipairs(controls) do
        if item.kind == "Label" and item.text == field then parent = item.parent end
    end
    assert(parent, "Linha ausente: " .. field)
    local result = {}
    for _, item in ipairs(controls) do
        if item.parent == parent then
            if item.kind == "Button" and item.text == "+" then result.plus = item end
            if item.kind == "Button" and item.text == "-" then result.minus = item end
            if item.kind == "Label" and item.width == 60 then result.value = item end
        end
    end
    return result
end
local function concentrationText()
    for _, item in ipairs(controls) do
        if item.kind == "Label" and item.text and item.text:find("Concentração temporária:", 1, true) then return item.text end
    end
    error("Concentração não exibida")
end
local function castButton()
    for _, item in ipairs(controls) do if item.kind == "Button" and item.text == "ROLAR FEITIÇO" then return item end end
    error("Botão de rolagem ausente")
end

test("números inteiros não mostram .0 e frações e textos são preservados", function()
    equal(lancamento.formatarNumero(10.0), "10")
    equal(lancamento.formatarNumero("-10.00"), "-10")
    equal(lancamento.formatarNumero(-0.0), "0")
    equal(lancamento.formatarNumero(1.5), "1.5")
    equal(lancamento.formatarNumero("4.5m"), "4.5m")
    equal(lancamento.formatarNumero("Cena"), "Cena")
    equal(lancamento.formatarNumero(nil), "")
end)

test("a abertura sempre inicia C0, conserva os valores salvos e impede reduzir o original", function()
    local root = fresh({concentracao = 18, C_FEI_Total = 8})
    local node = popupSpell(root)
    node.Grad = 0 -- Mesmo sem graduações disponíveis, a base não gera concentração temporária.
    feiticos.abrirPopupFeitico({boxDetalhesDoItem = {node = node}}, node)
    equal(concentrationText(), "Concentração temporária: C0 / C4")
    equal(row("Dano").value.text, "10"); equal(row("Area").value.text, "1.5")
    for _, field in ipairs({"Dano", "Area", "Range", "Duracao", "Poder", "Ataque"}) do
        equal(row(field).minus.enabled, false)
        row(field).minus.onClick() -- O handler também recusa a ação, independente do botão desabilitado.
    end
    equal(concentrationText(), "Concentração temporária: C0 / C4")
    equal(node.Dano, 10.0); equal(node.Dano_grad, 2.0); equal(root.concentracao, 18)
end)

test("o limite C4 é compartilhado por todas as melhorias e bloqueia o terceiro aumento", function()
    local root = fresh(); local node = popupSpell(root)
    feiticos.abrirPopupFeitico({boxDetalhesDoItem = {node = node}}, node)
    row("Dano").plus.onClick(); equal(row("Dano").value.text, "20")
    equal(concentrationText(), "Concentração temporária: C2 / C4")
    row("Poder").plus.onClick(); equal(row("Poder").value.text, "3")
    equal(concentrationText(), "Concentração temporária: C4 / C4")
    for _, field in ipairs({"Dano", "Area", "Range", "Duracao", "Poder", "Ataque"}) do
        equal(row(field).plus.enabled, false)
        row(field).plus.onClick()
    end
    equal(row("Dano").value.text, "20"); equal(row("Poder").value.text, "3")
    equal(row("Range").value.text, "4.5m")
    equal(concentrationText(), "Concentração temporária: C4 / C4")
end)

test("desfazer libera só a melhoria temporária e nunca usa a base para melhorar outro campo", function()
    local root = fresh(); local node = popupSpell(root)
    feiticos.abrirPopupFeitico({boxDetalhesDoItem = {node = node}}, node)
    row("Dano").plus.onClick(); row("Poder").plus.onClick()
    row("Dano").minus.onClick()
    equal(row("Dano").value.text, "10"); equal(row("Dano").minus.enabled, false)
    equal(concentrationText(), "Concentração temporária: C2 / C4")
    for _ = 1, 5 do row("Dano").minus.onClick() end
    equal(row("Dano").value.text, "10")
    equal(concentrationText(), "Concentração temporária: C2 / C4")
    row("Range").plus.onClick(); equal(row("Range").value.text, "6m")
    equal(concentrationText(), "Concentração temporária: C4 / C4")
    row("Area").plus.onClick(); equal(row("Area").value.text, "1.5")
end)

test("rolar usa as melhorias e a concentração temporária sem escrever na ficha", function()
    local root = fresh({concentracao = 9, C_FEI_Total = 8})
    local node = popupSpell(root)
    feiticos.abrirPopupFeitico({boxDetalhesDoItem = {node = node}}, node)
    row("Dano").plus.onClick()
    local originalSend = chat.enviarMensagem
    chat.enviarMensagem = function(self, message)
        equal(root.concentracao, 9); equal(node.Dano, 10.0); equal(node.Dano_grad, 2.0)
        originalSend(self, message)
    end
    local ok, reason = pcall(castButton().onClick)
    chat.enviarMensagem = originalSend
    assert(ok, reason)
    equal(evaluate(parsed[1]), 25) -- 20 + Grad 3 + Escola 4 - C2; ignora o 9 salvo.
    local boosted
    for _, message in ipairs(messages) do
        assert(not message:match("%d+%.0"), message)
        if message:find("Dano 20", 1, true) then boosted = true end
    end
    assert(boosted, "A mensagem não mostrou o dano temporário")
    equal(node.Dano, 10.0); equal(root.concentracao, 9)
end)

test("reabrir ou cancelar descarta melhorias e a nova janela volta a C0", function()
    local root = fresh({concentracao = 9}); local node = popupSpell(root)
    local context = {boxDetalhesDoItem = {node = node}}
    feiticos.abrirPopupFeitico(context, node)
    row("Dano").plus.onClick(); row("Poder").plus.onClick()
    for _, item in ipairs(controls) do if item.kind == "PopupForm" then item:close() end end
    controls = {}
    feiticos.abrirPopupFeitico(context, node)
    equal(concentrationText(), "Concentração temporária: C0 / C4")
    equal(row("Dano").value.text, "10"); equal(row("Poder").value.text, "2")
    equal(root.concentracao, 9)
end)

test("defesa cancelada e erro durante o lançamento não deixam valores temporários salvos", function()
    local root = fresh({concentracao = 9, C_FEI_Total = 8}); local node = popupSpell(root)
    node.tipo = "Defesa"
    feiticos.abrirPopupFeitico({boxDetalhesDoItem = {node = node}}, node)
    row("Poder").plus.onClick(); choices = {false}; castButton().onClick()
    equal(root.concentracao, 9); equal(node.Poder, 2.0)
    controls = {}
    feiticos.abrirPopupFeitico({boxDetalhesDoItem = {node = node}}, node)
    row("Dano").plus.onClick()
    local originalParse = rrpg.interpretarRolagem
    rrpg.interpretarRolagem = function() error("falha simulada") end
    local ok = pcall(castButton().onClick)
    rrpg.interpretarRolagem = originalParse
    equal(ok, false); equal(node.Dano, 10.0); equal(root.concentracao, 9)
end)

test("progressões são limitadas pela tabela e o ataque antigo sem índice mantém seu valor", function()
    local root = fresh(); local node = popupSpell(root)
    node.Ataque, node.Ataque_grad = 5.0, nil
    node.Dano, node.Dano_grad, node.Poder_array = 30.0, 4.0, "{1, 2, 3, 4}"
    local state = lancamento.novo(node)
    equal(state.preview.Ataque, 5.0); equal(state:concentracao(), 0)
    equal(state:podeAumentar("Dano"), false); equal(state:podeDiminuir("Dano"), false)
    equal(state:aumentar("Ataque"), true); equal(state.preview.Ataque, 6)
    equal(state:aumentar("Poder"), true); equal(state.preview.Poder, 3)
    equal(state:concentracao(), 4)
    equal(state:aumentar("Poder"), false)
    equal(node.Ataque, 5.0); equal(node.Ataque_grad, nil)
end)

local function checkbox(prefix)
    for _, item in ipairs(controls) do
        if item.kind == "CheckBox" and item.text:sub(1, #prefix) == prefix then return item end
    end
    error("Caixa ausente: " .. prefix)
end
local function messageContains(text)
    for _, message in ipairs(messages) do
        if message:gsub("%[§[^%]]*%]", ""):find(text, 1, true) then return true end
    end
    return false
end

test("menu de sete talentos mantém escolhas por feitiço sem incluir Treino ou Combo", function()
    local root = fresh(); local node = popupSpell(root)
    local context = {boxDetalhesDoItem = {node = node}, resumoTalentos = {text = ""}}
    feiticos.abrirTalentos(context, node)
    local count = 0
    for _, item in ipairs(controls) do
        if item.kind == "CheckBox" then
            count = count + 1
            assert(not item.text:find("Treino", 1, true)); assert(not item.text:find("Combo", 1, true))
        end
    end
    equal(count, 7)
    local maestria = checkbox("Mestre em Conjuração — 10h")
    maestria.checked = true; maestria.onChange()
    local poderoso = checkbox("Feitiço Potente — 20h")
    poderoso.checked = true; poderoso.onChange()
    equal(node.talentoMaestria, true); equal(node.talentoAtaquePoderoso, true)
    assert(context.resumoTalentos.text:find("Dano: 11", 1, true))
    equal(node.Dano, 10); equal(node.Poder, 2); equal(node.Grad, 3)
    controls = {}; feiticos.abrirTalentos(context, node)
    equal(checkbox("Mestre em Conjuração — 10h").checked, true)
    equal(checkbox("Feitiço Potente — 20h").checked, true)
    local other = popupSpell(root)
    context.boxDetalhesDoItem.node = other
    controls = {}; feiticos.abrirTalentos(context, other)
    equal(checkbox("Feitiço Potente — 20h").checked, false)
end)

test("Maestria converte qualquer grau de falha de Cast em estágio 1 sem transformar em sucesso", function()
    for _, enabled in ipairs({false, true}) do
        local root = fresh({concentracao = 0}); local node = spell(root, "Cast")
        node.CD, node.talentoMaestria = 100, enabled
        dice = {1}
        feiticos.rolarFeitico({boxDetalhesDoItem = {node = node}}, node)
        assert(messageContains(enabled and "1 estágio" or "4 estágios"))
        assert(not messageContains("✓ Sucesso")); equal(#parsed, 1)
        equal(node.CD, 100)
    end
end)

test("Mestre em Ataque exibe e aplica o mínimo mantendo Acerto e condição física", function()
    local root = fresh({concentracao = 0, acerto = 1, Exausto = true})
    local node = spell(root, "Ataque")
    node.talentoMaestriaSuperior, node.talentoCritico = true, true
    equal(talentos.minimoAtaque(node, root, -5), 10) -- 10 + DES 3 + GRAD 2 + Ataque 1 - Acerto 1 - Exausto 5.
    dice = {12, 1}
    feiticos.rolarFeitico({boxDetalhesDoItem = {node = node}}, node)
    assert(messageContains("Mestre em Ataque (mín.)"))
    assert(messageContains("ATAQUE: [ 1 ] +2 +3 +1 -1 -5 = 1 → 10"))
    assert(not messageContains("Crítico!"))
    messages, dice = {}, {20, 20}
    feiticos.rolarFeitico({boxDetalhesDoItem = {node = node}}, node)
    assert(messageContains("Mestre em Ataque (mín. 10)")) -- Mostra mesmo quando não precisou ajustar.
end)

test("o mínimo de Mestre em Ataque continua anunciado se a conjuração falhar", function()
